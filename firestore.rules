rules_version = '2';

// ============================================================
// FIRESTORE-SÄKERHETSREGLER — Klassrumsverktyget
//
// VARFÖR: hela klientkoden ligger publikt (GitHub Pages) — vem som
// helst kan läsa den, plocka isär datalagret och prata direkt med
// Firestore-API:t. Lösenordsväggen i js/auth.js skyddar bara
// gränssnittet, inte databasen. Därför MÅSTE dessa regler göra det
// riktiga jobbet: utan dem skulle elevdata (förnamn, noteringar) vara
// öppet läs- och skrivbart för vem som helst på nätet.
//
// PRINCIP: ingen oautentiserad åtkomst. All läsning och skrivning
// kräver en inloggad lärare (request.auth != null via Firebase Auth).
// Konton skapas i Firebase-konsolen — ingen öppen självregistrering
// (matchar ett arbetslag runt samma klasser, se docs/AUTH.md).
//
// ÅTKOMSTMODELL (se DATAMODELL.md):
//   DELAT mellan alla inloggade lärare (läs+skriv):
//     - klasser (classes/{id})
//     - elever, noteringar, pass/resultat, inställningar
//       (classes/{id}/students | notes | sessions | settings)
//     En lärare ska se alla andras noteringar på eleverna, sparade
//     pass och delade klassinställningar — realtid via onSnapshot.
//   PRIVAT per lärare (bara ägaren läser+skriver):
//     - lektionsplaneringar, under lärarens uid
//       (teachers/{uid}/classes/{cid}/lessonPlans/{planId})
//     Pathen bär ägarskapet: en lyssnare på det egna subträdet kan
//     aldrig råka få en annan lärares planeringar, så ingen where-sats
//     behövs på klienten och ingen extra get()-läsning i reglerna.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // En inloggad lärare (Firebase Auth). Ingen anonym åtkomst.
    function signedIn() {
      return request.auth != null;
    }

    // ---- PRIVAT per lärare -------------------------------------------
    // Lärarprofilen (email, displayName) OCH lärarens privata
    // lektionsplaneringar (teachers/{uid}/classes/{cid}/lessonPlans/…).
    // Var och en kommer bara åt sitt eget subträd.
    match /teachers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Allt under lärarens uid — inkl. de privata planeringarna.
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- DELAT mellan alla inloggade lärare --------------------------
    // Klassen och all delad klassdata: elever, noteringar, pass,
    // inställningar. Alla inloggade lärare läser och skriver — så att
    // ändringar syns hos alla i realtid (onSnapshot).
    match /classes/{classId} {
      allow read, write: if signedIn();

      // Subkollektioner: students, notes, sessions, settings.
      // (Lektionsplaneringar ligger INTE här — de är privata, se ovan.)
      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

    // Allt annat är låst som standard (defense in depth): en ny
    // kollektion är otillgänglig tills en regel uttryckligen öppnar den.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ------------------------------------------------------------
// NOT: planeringarna bär dessutom ett ownerUid-fält (sätts av
// js/data/plans.js). Det behövs inte av reglerna ovan — pathen under
// teachers/{uid} avgör redan ägarskapet — men gör ägaren explicit i
// datat. Vill man i stället lägga planeringar i en DELAD kollektion och
// skydda dem per fält ser regeln ut så här:
//
//   match /plans/{planId} {
//     allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
//     allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
//     allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
//   }
//
// (Då MÅSTE klientens lyssnare filtrera med where("ownerUid","==",uid),
//  annars nekas hela lyssnaren. Path-varianten ovan slipper det.)
// ------------------------------------------------------------
