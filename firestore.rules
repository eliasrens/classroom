rules_version = '2';

// ============================================================
// FIRESTORE-SÄKERHETSREGLER — Klassrumsverktyget
//
// VARFÖR: hela klientkoden ligger publikt (GitHub Pages) — vem som
// helst kan läsa den, plocka isär datalagret och prata direkt med
// Firestore-API:t. Lösenordsväggen i js/auth.js skyddar bara
// gränssnittet, inte databasen. Därför MÅSTE dessa regler göra det
// riktiga jobbet.
//
// PRINCIP (skärpt i issue #32): ingen oautentiserad åtkomst — och
// INGEN ELEVDATA ALLS i molnet. All elevdata (elevlistor, noteringar,
// Bra jobbat) lagras enbart lokalt på varje lärardator
// (js/data/local-only.js). Molnet innehåller bara klasstatistik:
// trafikljuspass och ANONYMA noteringsräkningar (noteStats).
// Reglerna nekar därför classes/{id}/students och /notes helt, och
// validerar noteStats fältvis så att studentId/text aldrig ens KAN
// skrivas dit.
//
// ÅTKOMSTMODELL (se DATAMODELL.md):
//   DELAT mellan alla inloggade lärare (läs+skriv):
//     - klasser (classes/{id})
//     - pass/resultat (classes/{id}/sessions)
//     - anonyma noteringsstreck (classes/{id}/noteStats) — endast
//       kända, icke-elevspecifika fält
//     - inställningar (classes/{id}/settings) — morningScreen får
//       ALDRIG innehålla praise/weekOf (Bra jobbat är lokal elevdata)
//   NEKAT HELT (elevdata hör inte hemma i molnet):
//     - classes/{id}/students/**, classes/{id}/notes/**,
//       classes/{id}/praiseArchive/**
//   PRIVAT per lärare (bara ägaren läser+skriver):
//     - teachers/{uid}/** (profil, klockmätning, lektionsplaneringar)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // En inloggad lärare (Firebase Auth). Ingen anonym åtkomst.
    function signedIn() {
      return request.auth != null;
    }

    // ---- PRIVAT per lärare -------------------------------------------
    match /teachers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- DELAT mellan alla inloggade lärare --------------------------
    match /classes/{classId} {
      allow read, write: if signedIn();

      // Trafikljuspass och andra genomförda pass — klasstatistik.
      match /sessions/{sessionId} {
        allow read, write: if signedIn();
      }

      // ANONYMA noteringsstreck (issue #32). Bara de kända fälten får
      // skrivas — studentId, text, followUp, helped, labelId kan
      // aldrig ta sig in (hasOnly), inte heller extra fält i
      // lektions-snapshoten. Uppdatering tillåts med samma validering
      // (pushen är en idempotent LWW-set); radering behövs när en
      // lokal notering tas bort eller klassen raderas.
      match /noteStats/{statId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(
               ['id', 'kind', 'typeId', 'positive', 'lesson',
                'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
          && (!('lesson' in request.resource.data)
              || request.resource.data.lesson == null
              || request.resource.data.lesson.keys().hasOnly(
                   ['date', 'start', 'end', 'subjectId', 'title']));
        allow delete: if signedIn();
      }

      // Klassinställningar. morningScreen får aldrig bära Bra jobbat
      // (praise/weekOf) — den listan är elevdata och lever lokalt.
      match /settings/{key} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn()
          && (key != 'morningScreen'
              || !('value' in request.resource.data)
              || !request.resource.data.value.keys().hasAny(['praise', 'weekOf']));
      }

      // ELEVDATA — nekas helt (lagras enbart lokalt, issue #32).
      match /students/{document=**} {
        allow read, write: if false;
      }
      match /notes/{document=**} {
        allow read, write: if false;
      }
      match /praiseArchive/{document=**} {
        allow read, write: if false;
      }
    }

    // Allt annat är låst som standard (defense in depth): en ny
    // kollektion är otillgänglig tills en regel uttryckligen öppnar den.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
